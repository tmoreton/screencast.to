# macOS
.DS_Store
.AppleDouble
.LSOverride

# Xcode user state
xcuserdata/
*.xcuserstate
*.xcscmblueprint
DerivedData/
build/

# Swift Package Manager
.build/
Packages/

# Local-only Swift source (anything named *.local.swift in any folder).
# Used for files that contain secrets / per-developer config and must never
# be committed (e.g. screencast/Upload/Config.local.swift).
**/*.local.swift

# Environment / secret files anywhere in the tree.
# Catches scripts/.env, worker/.env, and anything similar added later.
**/.env
**/.env.local
**/.env.*.local
**/.dev.vars

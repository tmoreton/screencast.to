# macOS
.DS_Store
.AppleDouble
.LSOverride

# Xcode user state
xcuserdata/
*.xcuserstate
*.xcscmblueprint
DerivedData/
build/

# Swift Package Manager
.build/
Packages/

# Node
node_modules/

# Generated GitHub Pages artifact.
site/

# Local-only Swift source (anything named *.local.swift in any folder).
# Used for files that contain secrets / per-developer config and must never
# be committed.
**/*.local.swift

# Environment / secret files anywhere in the tree (e.g. scripts/.env).
**/.env
**/.env.local
**/.env.*.local
**/.dev.vars

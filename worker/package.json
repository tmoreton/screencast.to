    "aws4fetch": "^1.0.20",
    "stripe": "22.6.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260813.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "wrangler": "^4.122.0"
  }

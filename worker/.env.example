# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# Your Cloudflare account ID (find it via `npx wrangler whoami` or the dashboard sidebar).
R2_ACCOUNT_ID=

# Name of the R2 bucket the script will create (or reuse) and the worker will write to.
R2_BUCKET=screencast-recordings

# R2 API token credentials.
# Dashboard → R2 → Manage R2 API Tokens → Create API Token
#   Permissions: Object Read & Write
#   Specify bucket: <R2_BUCKET above>
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Production custom domain attached to the R2 bucket (without https://).
# Do not use the rate-limited r2.dev development URL in production.
R2_PUB_HOST=

# Numeric Apple app ID assigned by App Store Connect (not the bundle ID).
APP_APPLE_ID=

# Server-only key for anonymous 15-minute upload tokens. Never embed this in
# an app binary. Generate with: openssl rand -hex 32
SERVICE_TOKEN_SECRET=

# The canonical deploy script requires this to remain blank. A private fork may
# use it only after choosing a distinct Worker name/routes and setting
# UPLOAD_AUTH_MODE=self-hosted in its own Wrangler configuration.
SELF_HOSTED_UPLOAD_TOKEN=

# Optional declared upload-size limit for /sign requests. Defaults to 1 GiB.
MAX_UPLOAD_BYTES=1073741824

# Restricted Stripe key for the direct-sale checkout. Grant only Customers
# and Checkout Sessions write access plus Prices and Products read access.
STRIPE_SECRET_KEY=

# Tokens shared with the corresponding GitHub Actions secrets. Generate each
# independently with `openssl rand -hex 32`.
SPARKLE_UPDATE_TOKEN=
RELEASE_PUBLISH_TOKEN=

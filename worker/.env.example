# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# Your Cloudflare account ID (find it via `npx wrangler whoami` or the dashboard sidebar).
R2_ACCOUNT_ID=

# Name of the R2 bucket the script will create (or reuse) and the worker will write to.
R2_BUCKET=notloom-opus

# R2 API token credentials.
# Dashboard → R2 → Manage R2 API Tokens → Create API Token
#   Permissions: Object Read & Write
#   Specify bucket: <R2_BUCKET above>
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Public host for objects. After enabling "Public Development URL" on the
# bucket (Settings tab in the dashboard), paste the pub-XXXXX.r2.dev value here
# (without https://). Example: pub-abc123def456.r2.dev
R2_PUB_HOST=

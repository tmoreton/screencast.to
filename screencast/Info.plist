<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Screencast.to</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Screencast.to</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Tim Moreton. All rights reserved.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSAudioCaptureUsageDescription</key>
	<string>Screencast.to records system audio when you enable System Audio for a screen recording.</string>
	<key>NSCameraUsageDescription</key>
	<string>Screencast.to records your camera when you include the floating camera bubble.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Screencast.to records your microphone when you include it in a screen recording.</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Screencast.to records the screen or region you choose so you can save and share a video.</string>
	<key>ScreencastSelfHostedUploadToken</key>
	<string>$(SCREENCAST_SELF_HOSTED_UPLOAD_TOKEN)</string>
	<key>ScreencastMarketingURL</key>
	<string>https://screencast.to</string>
	<key>ScreencastPrivacyURL</key>
	<string>https://screencast.to/privacy</string>
	<key>ScreencastSharingMode</key>
	<string>$(SCREENCAST_SHARING_MODE)</string>
	<key>ScreencastSupportURL</key>
	<string>https://screencast.to/support</string>
	<key>ScreencastWorkerBaseURL</key>
	<string>$(SCREENCAST_WORKER_BASE_URL)</string>
</dict>
</plist>

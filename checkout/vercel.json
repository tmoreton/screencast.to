{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.screencast.to" }],
      "destination": "https://screencast.to/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.screencast.to" }],
      "destination": "https://screencast.to/:path*",
      "permanent": true
    },
    {
      "source": "/confirmation.html",
      "has": [{ "type": "query", "key": "session_id", "value": "(?<session_id>.*)" }],
      "destination": "/api/complete",
      "permanent": false
    },
    { "source": "/privacy", "destination": "/policies/#privacy", "permanent": true },
    { "source": "/support", "destination": "/support.html", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'none'; form-action 'self' https://checkout.stripe.com; frame-ancestors 'none'; object-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/confirmation.html",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "private, no-store, max-age=0" }]
    }
  ]
}

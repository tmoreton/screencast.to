# Copy this file to scripts/.env and fill in real values.
# scripts/.env is gitignored by the root .gitignore. Never commit secrets.

# Apple notarization. Use either NOTARY_PROFILE or the Apple ID fields.
#
# To create a keychain profile:
#   xcrun notarytool store-credentials screencast \
#     --apple-id you@example.com \
#     --team-id YOUR_TEAM_ID \
#     --password xxxx-xxxx-xxxx-xxxx
NOTARY_PROFILE=

# Alternative to NOTARY_PROFILE:
APPLE_ID=
APPLE_TEAM_ID=
APPLE_APP_PASSWORD=

# Optional explicit signing identity. Defaults to "Developer ID Application".
DEVELOPER_ID_APPLICATION=

# Optional: configure a private/self-hosted Worker in local Developer ID builds.
# Leave both empty to keep hosted sharing disabled. Never use the official
# Screencast.to service token here.
SELF_HOSTED_WORKER_BASE_URL=
SELF_HOSTED_UPLOAD_TOKEN=
